---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="CherryPicker 🍒 · Ultralight Native macOS Launcher">
  <!-- Minimalist Navigation Bar -->
  <header class="sticky top-4 sm:top-6 z-50 max-w-4xl mx-auto px-3 sm:px-4">
    <nav class="apple-glass-pill rounded-full px-4 sm:px-5 py-2 sm:py-2.5 flex items-center justify-between">
      <a href="#" class="flex items-center gap-2 sm:gap-2.5 group">
        <img src={`${base}/app-icon.png`} alt="CherryPicker Icon" class="w-5 h-5 sm:w-6 sm:h-6 rounded-[5px] sm:rounded-[6px] shadow-sm transition-transform group-hover:scale-105 flex-shrink-0" />
        <span class="font-bold text-sm tracking-tight text-white">CherryPicker</span>
        <span class="text-[10px] font-mono px-1.5 sm:px-2 py-0.5 rounded-full bg-white/5 text-slate-300 border border-white/10 hidden xs:inline">v1.0 Native</span>
      </a>

      <div class="flex items-center gap-2 sm:gap-3">
        <a href="https://github.com/Wyroczen/CherryPicker" target="_blank" 
           class="hidden sm:flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-colors">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>Star on GitHub</span>
        </a>
        <a href="https://github.com/Wyroczen/CherryPicker/releases/latest" 
           class="px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-semibold text-white bg-rose-600 hover:bg-rose-500 shadow-md shadow-rose-950/60 border border-rose-400/30 transition-all hover:scale-[1.02] whitespace-nowrap">
          Download .dmg
        </a>
      </div>
    </nav>
  </header>

  <!-- Hero Section -->
  <main class="max-w-6xl mx-auto px-4 pt-14 sm:pt-20 pb-12 text-center">
    
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-slate-300 mb-6 sm:mb-8 backdrop-blur-md">
      <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
      <span class="font-medium text-white">Native Swift & AppKit</span>
      <span class="text-slate-600">·</span>
      <span class="text-slate-300">Instant Window Tiling</span>
      <span class="text-slate-600">·</span>
      <span class="text-rose-400 font-mono">Sub-5ms Spotlight Engine</span>
    </div>

    <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-white mb-5 sm:mb-6 leading-[1.08]">
      Your Mac. Your Windows.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-rose-300">Instantly.</span>
    </h1>

    <p class="text-sm sm:text-lg text-slate-400 max-w-xl mx-auto mb-8 sm:mb-10 leading-relaxed font-normal">
      Ultralight launcher and window manager for macOS. Built in pure Swift and AppKit with native Liquid Glass, zero external dependencies, and zero telemetry.
    </p>

    <!-- CTAs and Hotkey Pill -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-12 sm:mb-16">
      <a href="https://github.com/Wyroczen/CherryPicker/releases/latest" 
         class="px-5 sm:px-6 py-2.5 sm:py-3 rounded-2xl bg-white text-black hover:bg-slate-100 font-semibold text-xs tracking-tight transition-all hover:scale-[1.02] shadow-xl shadow-white/10 flex items-center gap-2">
        <span>Download for macOS (.dmg)</span>
        <span>↓</span>
      </a>

      <div class="apple-glass-pill px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-2xl flex items-center gap-2 text-xs text-slate-300 font-medium">
        <span class="text-slate-400">Hotkey:</span>
        <span class="keycap-apple px-2 py-0.5 rounded text-white font-mono text-[11px] font-medium whitespace-nowrap">⌥ Option</span>
        <span class="text-slate-500">+</span>
        <span class="keycap-apple px-2.5 py-0.5 rounded text-white font-mono text-[11px] font-medium whitespace-nowrap">Space</span>
      </div>
    </div>

    <!-- SIGNATURE SHOWCASE: 100% Faithful CherryPicker HUD floating on Ambient macOS Nature Wallpapers -->
    <div class="relative max-w-5xl mx-auto pt-2 pb-12 sm:pb-16 px-1 sm:px-0">
      
      <!-- Desktop Display Viewport with Ambient Wallpaper Crossfade -->
      <div id="desktop-viewport" 
           class="relative rounded-2xl sm:rounded-[32px] overflow-hidden border border-white/15 shadow-[0_40px_100px_-20px_rgba(0,0,0,0.9)] min-h-[460px] sm:min-h-[510px] flex items-center justify-center p-3 sm:p-8 select-none">
        
        <!-- Wallpaper Slides (Automatic Smooth Ambient Crossfade) -->
        <div id="slide-0" class="wallpaper-slide opacity-100"
             style={`background-image: url('${base}/wallpapers/sonoma.jpg');`}></div>
        
        <div id="slide-1" class="wallpaper-slide opacity-0"
             style={`background-image: url('${base}/wallpapers/big-sur.jpg');`}></div>
        
        <div id="slide-2" class="wallpaper-slide opacity-0"
             style={`background-image: url('${base}/wallpapers/catalina-sunset.jpg');`}></div>

        <!-- Microscopic Wallpaper Status Badge (Bottom Right) -->
        <div class="absolute bottom-3 right-4 sm:bottom-4 sm:right-5 z-20 flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-[9px] sm:text-[10px] font-mono text-white/70">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
          <span id="wallpaper-label">Sonoma Hills</span>
        </div>

        <!-- THE HUD: 1000% Faithful Reproduction of MainHUDView.swift (Matching User Screenshot) -->
        <div id="hud-card" class="cherrypicker-hud z-20 text-left select-none overflow-hidden mx-auto">
          
          <!-- Layer 1: Full-Bleed Results List with Seamless Scroll Gradient Mask (Lines 111-147) -->
          <div id="hud-scroll-container" 
               class="seamless-scroll-mask no-scrollbar absolute inset-0 overflow-y-auto px-2.5 sm:px-3 pt-[54px] pb-[40px] space-y-[3px] z-10">
            
            <!-- Row 1: Top Half (Fading softly under the top search bar) -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Top Half" data-kind="Command:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-gradient-to-br from-[#38bdf8] to-[#2563eb] p-[3.5px] border border-white/35 shadow-sm flex items-start justify-center flex-shrink-0">
                  <div class="w-full h-full bg-black/25 rounded-[3px] p-[1px] flex items-start">
                    <div class="w-full h-1/2 bg-white rounded-[1.5px] shadow-sm"></div>
                  </div>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Top Half</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">Top half of screen (50% height)</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Command
              </span>
            </div>

            <!-- Row 2: Left Half -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Left Half" data-kind="Command:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-gradient-to-br from-[#38bdf8] to-[#2563eb] p-[3.5px] border border-white/35 shadow-sm flex items-center justify-start flex-shrink-0">
                  <div class="w-full h-full bg-black/25 rounded-[3px] p-[1px] flex items-center">
                    <div class="w-1/2 h-full bg-white rounded-[1.5px] shadow-sm"></div>
                  </div>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Left Half</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">Left half of screen (50% width)</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Command
              </span>
            </div>

            <!-- Row 3: Right Half -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Right Half" data-kind="Command:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-gradient-to-br from-[#38bdf8] to-[#2563eb] p-[3.5px] border border-white/35 shadow-sm flex items-center justify-end flex-shrink-0">
                  <div class="w-full h-full bg-black/25 rounded-[3px] p-[1px] flex items-center justify-end">
                    <div class="w-1/2 h-full bg-white rounded-[1.5px] shadow-sm"></div>
                  </div>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Right Half</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">Right half of screen (50% width)</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Command
              </span>
            </div>

            <!-- Row 4: Maximize -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Maximize" data-kind="Command:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-gradient-to-br from-[#38bdf8] to-[#2563eb] p-[3.5px] border border-white/35 shadow-sm flex items-center justify-center flex-shrink-0">
                  <div class="w-full h-full bg-black/25 rounded-[3px] p-[1px] flex items-center">
                    <div class="w-full h-full bg-white rounded-[1.5px] shadow-sm"></div>
                  </div>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Maximize</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">Fill full screen</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Command
              </span>
            </div>

            <!-- Row 5: First Two Thirds -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="First Two Thirds" data-kind="Command:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-gradient-to-br from-[#38bdf8] to-[#2563eb] p-[3.5px] border border-white/35 shadow-sm flex items-center justify-start flex-shrink-0">
                  <div class="w-full h-full bg-black/25 rounded-[3px] p-[1px] flex items-center">
                    <div class="w-2/3 h-full bg-white rounded-[1.5px] shadow-sm"></div>
                  </div>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">First Two Thirds</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">Left two thirds of screen (66% width)</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Command
              </span>
            </div>

            <!-- Row 6: Xcode (SELECTED STATE - Exactly matches user's screenshot media_1794335496886_714a4531.jpg) -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] bg-white/[0.11] transition-colors cursor-pointer"
                 data-action="Xcode" data-kind="Open application:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-sky-950/70 border border-sky-400/30 flex items-center justify-center text-xs shadow-sm flex-shrink-0">
                  🔨
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-semibold text-white tracking-tight leading-snug truncate">Xcode</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/70 leading-tight truncate">/Applications/Xcode.app</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/90 px-2 py-0.5 rounded-[6px] bg-white/[0.16] flex-shrink-0 ml-2">
                Application
              </span>
            </div>

            <!-- Row 7: Safari -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Safari" data-kind="Open application:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-blue-950/70 border border-blue-400/30 flex items-center justify-center text-xs shadow-sm flex-shrink-0">
                  🧭
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Safari</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">/Applications/Safari.app</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Application
              </span>
            </div>

            <!-- Row 8: MainHUDView.swift (File Result from Spotlight MDQuery) -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="MainHUDView.swift" data-kind="Open file:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-xs shadow-sm flex-shrink-0">
                  <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="9" y1="13" x2="15" y2="13"></line>
                    <line x1="9" y1="17" x2="13" y2="17"></line>
                  </svg>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">MainHUDView.swift</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">~/Projects/CherryPicker/Sources/MainHUDView.swift</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                File
              </span>
            </div>

            <!-- Row 9: Terminal -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Terminal" data-kind="Open application:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-black/80 border border-white/20 flex items-center justify-center text-[11px] font-mono font-bold text-white shadow-sm flex-shrink-0">
                  &gt;_
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Terminal</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">/System/Applications/Utilities/Terminal.app</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Application
              </span>
            </div>

            <!-- Row 10: Project_Roadmap.pdf (File Result from Spotlight MDQuery) -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Project_Roadmap.pdf" data-kind="Open file:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-rose-500/15 border border-rose-400/30 flex items-center justify-center text-xs shadow-sm flex-shrink-0">
                  <svg class="w-4 h-4 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <text x="7" y="17" font-size="7" font-family="monospace" font-weight="bold" fill="currentColor">PDF</text>
                  </svg>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Project_Roadmap.pdf</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">~/Documents/Project_Roadmap.pdf</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                File
              </span>
            </div>

            <!-- Row 9: Center Half -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Center Half" data-kind="Command:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-gradient-to-br from-[#38bdf8] to-[#2563eb] p-[3.5px] border border-white/35 shadow-sm flex items-center justify-center flex-shrink-0">
                  <div class="w-full h-full bg-black/25 rounded-[3px] p-[1px] flex items-center justify-center">
                    <div class="w-1/2 h-full bg-white rounded-[1.5px] shadow-sm"></div>
                  </div>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Center Half</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">Centered 50% screen width</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Command
              </span>
            </div>

            <!-- Row 10: System Settings -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="System Settings" data-kind="Open application:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-slate-800 border border-slate-600/40 flex items-center justify-center text-xs shadow-sm flex-shrink-0">
                  ⚙️
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">System Settings</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">/System/Applications/System Settings.app</div>
                </div>
              </div>
              <span class="hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2">
                Application
              </span>
            </div>

            <!-- Row 11: Top-Right Quarter (Fading softly above footer) -->
            <div class="hud-item flex items-center justify-between py-1.5 px-2.5 rounded-[10px] transition-colors cursor-pointer"
                 data-action="Top-Right Quarter" data-kind="Command:">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-7 h-7 rounded-[7px] bg-gradient-to-br from-[#38bdf8] to-[#2563eb] p-[3.5px] border border-white/35 shadow-sm flex items-start justify-end flex-shrink-0">
                  <div class="w-full h-full bg-black/25 rounded-[3px] p-[1px] flex items-start justify-end">
                    <div class="w-1/2 h-1/2 bg-white rounded-[1.5px] shadow-sm"></div>
                  </div>
                </div>
                <div class="min-w-0">
                  <div class="text-[13px] sm:text-[13.5px] font-medium text-white/90 tracking-tight leading-snug truncate">Top-Right Quarter</div>
                  <div class="text-[10.5px] sm:text-[11px] text-white/45 leading-tight truncate">Top right quarter of screen (25% area)</div>
                </div>
              </div>
