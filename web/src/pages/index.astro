  <script>
    // Specular Highlight tracking
    const hudCard = document.getElementById('hud-card');
    const viewport = document.getElementById('desktop-viewport');

    if (viewport && hudCard) {
      viewport.addEventListener('mousemove', (e) => {
        const rect = hudCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        hudCard.style.setProperty('--mouse-x', `${x}px`);
        hudCard.style.setProperty('--mouse-y', `${y}px`);
      });
    }

    // Automatic Ambient Wallpaper Carousel (Smooth Crossfade every 6 seconds)
    const slides = [
      { id: 'slide-0', label: 'Sonoma Hills' },
      { id: 'slide-1', label: 'Big Sur Coast' },
      { id: 'slide-2', label: 'Catalina Sunset' }
    ];
    let currentSlide = 0;
    const wallpaperLabel = document.getElementById('wallpaper-label');

    setInterval(() => {
      currentSlide = (currentSlide + 1) % slides.length;
      slides.forEach((slide, idx) => {
        const el = document.getElementById(slide.id);
        if (el) {
          el.style.opacity = idx === currentSlide ? '1' : '0';
        }
      });
      if (wallpaperLabel) {
        wallpaperLabel.innerText = slides[currentSlide].label;
      }
    }, 6000);

    // Initial Scroll Position: Scroll down slightly so items fade under top header AND above footer
    const scrollContainer = document.getElementById('hud-scroll-container');
    if (scrollContainer) {
      // Sets scroll position to visibly showcase the soft gradient ramp at both top and bottom
      scrollContainer.scrollTop = 48;
    }

    // Single Active Item Selection on Mouse Hover (Authentic macOS Spotlight/Raycast behavior)
    const hudItems = document.querySelectorAll('.hud-item');
    const footerKind = document.getElementById('footer-kind');
    const footerTitle = document.getElementById('footer-title');

    function activateItem(item: Element) {
      hudItems.forEach(i => {
        i.classList.remove('bg-white/[0.11]');
        const badge = i.querySelector('.hud-badge');
        if (badge) {
          badge.className = 'hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/65 px-2 py-0.5 rounded-[6px] bg-white/[0.08] flex-shrink-0 ml-2';
        }
      });

      item.classList.add('bg-white/[0.11]');
      const badge = item.querySelector('.hud-badge');
      if (badge) {
        badge.className = 'hud-badge text-[9.5px] sm:text-[10px] font-semibold text-white/90 px-2 py-0.5 rounded-[6px] bg-white/[0.16] flex-shrink-0 ml-2';
      }

      if (footerKind && footerTitle) {
        footerKind.innerText = (item as HTMLElement).dataset.kind || 'Command:';
        footerTitle.innerText = (item as HTMLElement).dataset.action || '';
      }
    }

    hudItems.forEach(item => {
      // Hover immediately moves the active selection - exactly one row is highlighted at all times
      item.addEventListener('mouseenter', () => activateItem(item));
      item.addEventListener('click', () => activateItem(item));
    });

    // Live search filter
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
        let firstVisible: Element | null = null;

        hudItems.forEach(item => {
          const text = (item as HTMLElement).innerText.toLowerCase();
          if (text.includes(q)) {
            (item as HTMLElement).style.display = 'flex';
            if (!firstVisible) firstVisible = item;
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });

        // Automatically select the first matching search result
        if (firstVisible) {
          activateItem(firstVisible);
        }
      });
    }

    // Copy command
    const copyBtn = document.getElementById('copy-btn');
    const cmdToCopy = document.getElementById('cmd-to-copy');
    const copyText = document.getElementById('copy-text');

    copyBtn?.addEventListener('click', () => {
      if (cmdToCopy && copyText) {
        navigator.clipboard.writeText(cmdToCopy.innerText).then(() => {
          copyText.innerText = 'Copied to Clipboard!';
          setTimeout(() => {
            copyText.innerText = 'Copy Build Command';
          }, 2000);
        });
      }
    });
  </script>
